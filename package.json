{
  "name": "miturno-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "set NODE_ENV=dev && electron .",
    "electron:build": "set ELECTRON=true && npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^latest",
    "electron-builder": "^latest",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.miturno.app",
    "productName": "MiTurno",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "public/icon-512.png"
    },
    "forceCodeSigning": false,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}