const GEMINI_API_KEY = import.meta.env.VITE_GEMINI_API_KEY;

// Modelos de Gemini, en orden de preferencia.
// Si el primero falla (404 por retiro, sobrecarga, etc.) se intenta el siguiente.
const MODELOS_FALLBACK = [
  'gemini-3.1-flash-lite',
  'gemini-2.5-flash-lite',
];

const construirPrompt = (datosPaciente) => `Eres un médico de triaje hospitalario con experiencia en el sistema Manchester. Analiza DETENIDAMENTE el motivo de consulta y los antecedentes del paciente para determinar la gravedad.

MOTIVO DE CONSULTA (analiza palabras clave): "${datosPaciente.motivo || 'No especificado'}"
ANTECEDENTES (busca condiciones de riesgo): "${datosPaciente.antecedentes || 'Ninguno'}"

DATOS COMPLEMENTARIOS:
- Edad: ${datosPaciente.edad || '?'} años
- Especialidad: ${datosPaciente.especialidad || 'General'}
- Signos vitales: ${JSON.stringify(datosPaciente.vitales || {})}
- Signos de alarma: ${(datosPaciente.signosAlarma || []).join(', ') || 'Ninguno'}
- Escala de dolor: ${datosPaciente.escalaDolor || 0}/10

Palabras clave de ALTO RIESGO en el motivo: "paro", "no respira", "inconsciente", "convulsión", "sangrado masivo", "dolor intenso", "infarto", "parto", "labor de parto".
Palabras clave de RIESGO MODERADO: "fiebre alta", "vómito", "caída", "fractura", "dolor moderado".
Antecedentes de riesgo: "diabetes", "hipertensión", "cardiópata", "EPOC", "inmunosuprimido", "cáncer".

Sugiere un nivel de triaje (N1=Resucitación, N2=Emergencia, N3=Urgencia, N4=Menor, N5=NoUrgente).
Responde SOLO con JSON: {"nivel":2,"nombre":"EMERGENCIA","razon":"Explicación detallada basada en el motivo y antecedentes","recomendacion":"Acción recomendada"}`;

// Intenta un solo modelo. Devuelve el JSON parseado o lanza un error específico.
const intentarModelo = async (modelo, prompt) => {
  const response = await fetch(
    `https://generativelanguage.googleapis.com/v1beta/models/${modelo}:generateContent?key=${GEMINI_API_KEY}`,
    {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ parts: [{ text: prompt }] }],
      }),
    }
  );

  if (response.status === 429) {
    const err = new Error('RATE_LIMIT');
    err.status = 429;
    throw err;
  }

  if (!response.ok) {
    const textoError = await response.text().catch(() => '');
    const err = new Error(`Error del servidor: ${response.status}`);
    err.status = response.status;
    err.detalle = textoError;
    throw err;
  }

  const data = await response.json();
  const candidate = data.candidates?.[0];

  if (!candidate) {
    throw new Error('La IA no pudo generar una respuesta. Intenta de nuevo.');
  }

  // Gemini bloqueó la respuesta por sus filtros de seguridad (común en temas médicos)
  if (candidate.finishReason === 'SAFETY' || !candidate.content?.parts?.[0]?.text) {
    const err = new Error('La IA no pudo responder por filtros de contenido. Intenta reformular el motivo/antecedentes.');
    err.motivo = 'SAFETY_BLOCK';
    throw err;
  }

  const texto = candidate.content.parts[0].text;
  const jsonMatch = texto.match(/\{[\s\S]*\}/);

  if (!jsonMatch) {
    throw new Error('Formato de respuesta inválido (no es JSON).');
  }

  return JSON.parse(jsonMatch[0]);
};

export const sugerirTriageIA = async (datosPaciente) => {
  if (!GEMINI_API_KEY) {
    throw new Error('API Key de Gemini no configurada');
  }

  const prompt = construirPrompt(datosPaciente);
  let ultimoError = null;

  for (const modelo of MODELOS_FALLBACK) {
    try {
      const resultado = await intentarModelo(modelo, prompt);
      return resultado;
    } catch (err) {
      console.error(`Error con modelo "${modelo}":`, err, err.detalle || '');
      ultimoError = err;

      // Si fue un bloqueo de seguridad, no tiene caso reintentar con otro modelo
      // (probablemente también lo bloquee) — mejor cortar aquí y avisar.
      if (err.motivo === 'SAFETY_BLOCK') {
        throw err;
      }
      continue;
    }
  }

  if (ultimoError?.status === 429) {
    throw new Error('Límite de consultas alcanzado. Espera un minuto e intenta de nuevo.');
  }

  throw new Error(ultimoError?.message || 'No se pudo consultar la IA. Intenta de nuevo.');
};